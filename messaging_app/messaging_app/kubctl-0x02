#!/bin/bash
# kubctl-0x02
# Apply blue & green deployments and check logs of green before switching traffic.

set -e

echo ">>> Applying blue deployment..."
kubectl apply -f blue_deployment.yaml

echo ">>> Applying green deployment..."
kubectl apply -f green_deployment.yaml

echo ">>> Applying service (currently pointing to 'blue' version)..."
kubectl apply -f kubeservice.yaml

echo ">>> Listing pods for blue and green..."
kubectl get pods -l app=messaging-app -o wide

echo ">>> Fetching logs from green deployment pod(s)..."
GREEN_POD=$(kubectl get pods -l app=messaging-app,version=green -o jsonpath='{.items[0].metadata.name}')
echo ">>> Logs for green pod: $GREEN_POD"
kubectl logs "$GREEN_POD"

echo ">>> To switch traffic to green, update kubeservice.yaml selector to 'version: green' and re-apply."
echo ">>> Example: edit kubeservice.yaml and run: kubectl apply -f kubeservice.yaml"

echo ">>> Done."
