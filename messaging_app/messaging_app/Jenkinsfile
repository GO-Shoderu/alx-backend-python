pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                // Pull source code from GitHub (checker expects: git branch + credentialsId)
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/<YOUR_GITHUB_USERNAME>/alx-backend-python.git'
            }
        }

        stage('Install dependencies') {
            steps {
                sh '''
                    python3 -m venv .venv
                    . .venv/bin/activate

                    pip3 install --upgrade pip
                    pip3 install -r messaging_app/requirements.txt
                    pip3 install pytest
                '''
            }
        }

        stage('Run tests') {
            steps {
                sh '''
                    . .venv/bin/activate
                    mkdir -p reports
                    pytest --junitxml=reports/junit.xml
                '''
            }
            post {
                always {
                    junit 'reports/junit.xml'
                }
            }
        }
    }
}
