pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        VENV_DIR = ".venv"
        REPORT_DIR = "reports"
        JUNIT_REPORT = "reports/junit.xml"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Python Env') {
            steps {
                sh '''
                    python3 -m venv ${VENV_DIR}
                    . ${VENV_DIR}/bin/activate
                    python -m pip install --upgrade pip
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    . ${VENV_DIR}/bin/activate

                    # If you have requirements.txt, install it
                    if [ -f requirements.txt ]; then
                        pip install -r requirements.txt
                    fi

                    # Ensure pytest + reporting support exist
                    pip install pytest
                '''
            }
        }

        stage('Run Tests (pytest)') {
            steps {
                sh '''
                    . ${VENV_DIR}/bin/activate
                    mkdir -p ${REPORT_DIR}

                    # Run tests and generate JUnit XML report
                    pytest -q --junitxml=${JUNIT_REPORT}
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${JUNIT_REPORT}"
                }
            }
        }
    }
}
